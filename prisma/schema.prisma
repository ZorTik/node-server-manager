// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ServiceLogSource {
  ENGINE
  CONTAINER
}

model Service {
  serviceId String           @id @default(uuid())
  nodeId    String
  imageId   String?
  template  String
  port      Int
  options   Json
  meta      Json             @default("{}")
  args      Json             @default("{}")
  network   Json?
  image     Image?           @relation(fields: [imageId], references: [id])
  sessions  ServiceSession[]
}

model ServiceMeta {
  serviceId String @id
  key       String @unique
  value     Json
}

model ServiceSession {
  id        String             @id @default(uuid())
  serviceId String
  service   Service            @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)
  logs      ServiceLogRecord[]
  startedAt DateTime           @default(now())
}

model ServiceLogRecord {
  id        BigInt           @id @default(autoincrement())
  sessionId String
  timestamp DateTime         @default(now())
  source    ServiceLogSource
  logLevel  String
  message   String           @db.LongText
  session   ServiceSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Persistent key-value storage for system-wide attributes.
model Meta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id           String             @id
  templateId   String
  hash         String
  buildOptions ImageBuildOption[]
  services     Service[]
}

model ImageBuildOption {
  id      String @id @default(uuid())
  imageId String
  key     String
  value   String
  image   Image? @relation(fields: [imageId], references: [id], onDelete: Cascade)
}
